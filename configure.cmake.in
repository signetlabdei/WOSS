# This file passes variables from top-level to subdirectories

# Pass NETCDF variables
set(NETCDF_FOUND @NETCDF_FOUND@)
set(NETCDF4_FOUND @NETCDF4_FOUND@)
set(NETCDF_INCLUDE_DIR @NETCDF_INCLUDE_DIR@)
set(NETCDF_LIBRARY @NETCDF_LIBRARY@)
set(NETCDF_CXX_LIBRARY @NETCDF_CXX_LIBRARY@)
set(NETCDF4_INCLUDE_DIR @NETCDF4_INCLUDE_DIR@)
set(NETCDF4_LIBRARY @NETCDF4_LIBRARY@)
set(HDF5_LIBRARY @HDF5_LIBRARY@)

# Pass NS MIRACLE variables
set(NS_MIRACLE_FOUND @NS_MIRACLE_FOUND@)
set(NS_ALLINONE_PATH @NS_ALLINONE_PATH@)
set(NSMIRACLE_PATH @NSMIRACLE_PATH@)

# Pass compile definitions
set(WOSS_ENABLE_MULTITHREAD @WOSS_ENABLE_MULTITHREAD@)
